				"description": "API - Reject invalid Type value\n\n**Test ID:** SF-550-API-005\n**Priority:** p2\n**Tags:** @negative @invalid-value\n\n**Expected:** API should reject invalid Type value and return error mentioning \"Type\""
			},
			"response": []
		},
		{
			"name": "SF-550-API-006 - Query Account with Agency Type",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Type equals Agency\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.records && jsonData.records.length > 0) {",
							"        pm.expect(jsonData.records[0].Type).to.equal('Agency');",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/services/data/{{api_version}}/query/?q=SELECT Id, Name, Type FROM Account WHERE Type = 'Agency' LIMIT 1",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"services",
						"data",
						"{{api_version}}",
						"query",
						""
					],
					"query": [
						{
							"key": "q",
							"value": "SELECT Id, Name, Type FROM Account WHERE Type = 'Agency' LIMIT 1"
						}
					]
				},
				"description": "API - Handle Account with Type other than TPA Group\n\n**Test ID:** SF-550-API-006\n**Priority:** p2\n**Tags:** @negative @null-value\n\n**Prerequisite:** Requires a test Account created via API with Type \"Agency\""
			},
