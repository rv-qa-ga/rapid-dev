					"path": [
						"services",
						"data",
						"{{api_version}}",
						"sobjects",
						"Account",
						"describe"
					]
				},
				"description": "API - Verify Account__c field exists on Account\n\n**Test ID:** SF-490-API-002\n**Priority:** p1\n**Tags:** @field-exists"
			},
			"response": []
