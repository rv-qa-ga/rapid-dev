					"host": [
						"{{base_url}}"
					],
					"path": [
						"services",
						"data",
						"{{api_version}}",
						"sobjects",
						"Lead",
						"{{lead_id}}"
					]
				},
				"description": "API - Update Account__c on Lead\n\n**Test ID:** SF-490-API-004\n**Priority:** p1\n**Tags:** @api-update\n\n**Prerequisite:** Requires an existing Lead record (set lead_id variable)"
			},
			"response": []
		},
		{
			"name": "SF-490-API-005 - Query Lead by Account",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains records\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('records');",
							"    pm.expect(jsonData.records).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/services/data/{{api_version}}/query/?q=SELECT Id, LastName, Company, Account__c FROM Lead LIMIT 10",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"services",
						"data",
						"{{api_version}}",
						"query",
						""
					],
					"query": [
						{
							"key": "q",
							"value": "SELECT Id, LastName, Company, Account__c FROM Lead LIMIT 10"
						}
					]
				},
				"description": "API - Query Lead by Account\n\n**Test ID:** SF-490-API-005\n**Priority:** p2\n**Tags:** @api-query\n\n**Prerequisite:** Requires an existing Lead record"
			},
			"response": []
		},
		{
			"name": "SF-490-API-006 - Reject invalid Account__c value",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code indicates error\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
							"});",
							"",
							"pm.test(\"Error response mentions Account\", function () {",
							"    var jsonData = pm.response.json();",
							"    var errorText = JSON.stringify(jsonData);",
							"    pm.expect(errorText.toLowerCase()).to.include('account');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"LastName\": \"Invalid Test Lead\",\n  \"Company\": \"Test Company\",\n  \"Account__c\": \"INVALID_VALUE_###\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/services/data/{{api_version}}/sobjects/Lead/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"services",
						"data",
						"{{api_version}}",
						"sobjects",
						"Lead",
						""
					]
				},
				"description": "API - Reject invalid Account__c value\n\n**Test ID:** SF-490-API-006\n**Priority:** p2\n**Tags:** @negative @invalid-value\n\n**Expected:** API should reject invalid Account__c value and return error mentioning \"Account\""
			},
			"response": []
		},
		{
			"name": "SF-490-API-007 - Handle null Account__c value",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Account__c is null or empty\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.records && jsonData.records.length > 0) {",
							"        var record = jsonData.records[0];",
							"        pm.expect(record.Account__c === null || record.Account__c === '' || record.Account__c === undefined).to.be.true;",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/services/data/{{api_version}}/query/?q=SELECT Id, LastName, Company, Account__c FROM Lead WHERE Account__c = null LIMIT 1",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"services",
						"data",
						"{{api_version}}",
						"query",
						""
					],
					"query": [
						{
							"key": "q",
							"value": "SELECT Id, LastName, Company, Account__c FROM Lead WHERE Account__c = null LIMIT 1"
						}
					]
				},
				"description": "API - Handle null Account__c value\n\n**Test ID:** SF-490-API-007\n**Priority:** p2\n**Tags:** @negative @null-value\n\n**Prerequisite:** Requires a test Lead created via API without Account"
			},
			"response": []
