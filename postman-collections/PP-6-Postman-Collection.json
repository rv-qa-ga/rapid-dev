			"name": "PP-6-API-001: Create Master Agreement (Minimum Fields)",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 201\", function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"",
							"pm.test(\"Response contains Master Agreement ID\", function () {",
							"    var jsonData = pm.response.json();",
							"    // Dynamics returns ID in response body or @odata.id",
							"    var recordId = jsonData.accelins_masteragreementid || jsonData.id;",
							"    if (!recordId) {",
							"        // Try to extract from @odata.id",
							"        var odataId = jsonData['@odata.id'];",
							"        if (odataId) {",
							"            var match = odataId.match(/\\(([a-f0-9-]{36})\\)/i);",
							"            if (match) {",
							"                recordId = match[1];",
							"            }",
							"        }",
							"    }",
							"    pm.expect(recordId).to.not.be.empty;",
							"    pm.collectionVariables.set(\"master_agreement_id\", recordId);",
							"    pm.collectionVariables.set(\"record_id\", recordId);",
							"    console.log(\"✅ Master Agreement ID saved: \" + recordId);",
							"});",
							"",
							"pm.test(\"Response contains Master Agreement Master ID\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property(\"accelins_masteragreementmasterid\");",
							"    console.log(\"✅ Master Agreement Master ID: \" + jsonData.accelins_masteragreementmasterid);",
							"});"
						],
						"type": "text/javascript"
					}
				}
