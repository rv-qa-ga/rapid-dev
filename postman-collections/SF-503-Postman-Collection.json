      "name": "Field Existence Verification",
      "item": [
        {
          "name": "SF-503-API-001 - Describe Lead Object",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Sub_Type__c field exists on Lead\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var fields = jsonData.fields;",
                  "    var field = fields.find(function(f) { return f.name === 'Sub_Type__c'; });",
                  "    ",
                  "    if (!field) {",
                  "        var fieldNames = fields.map(function(f) { return f.name; });",
                  "        var subtypeFields = fieldNames.filter(function(name) { return name.toLowerCase().includes('sub') && name.toLowerCase().includes('type'); });",
                  "        console.error('❌ Field Sub_Type__c not found on Lead');",
                  "        if (subtypeFields.length > 0) {",
                  "            console.error('Similar fields found: ' + subtypeFields.join(', '));",
                  "        }",
                  "    }",
                  "    ",
                  "    pm.expect(field).to.not.be.undefined;",
                  "    pm.expect(field.name).to.equal('Sub_Type__c');",
                  "    console.log('✅ Sub_Type__c field found on Lead');",
                  "    console.log('Field Type: ' + field.type);",
                  "    console.log('Field Label: ' + field.label);",
                  "    ",
                  "    // Verify field is NOT required",
                  "    if (field.required !== undefined) {",
                  "        console.log('Required: ' + field.required);",
                  "        pm.expect(field.required).to.be.false;",
                  "        console.log('✅ Sub_Type__c is NOT required (as expected)');",
                  "    } else {",
                  "        console.log('⚠️ Required property not found in field metadata');",
                  "    }",
                  "    ",
                  "    if (field.nillable !== undefined) {",
                  "        console.log('Nillable: ' + field.nillable);",
                  "        pm.expect(field.nillable).to.be.true;",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/services/data/{{api_version}}/sobjects/Lead/describe",
