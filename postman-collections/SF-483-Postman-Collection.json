      "item": [
        {
          "name": "SF-483-API-001 - Describe Account Object",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Upsell_Opportunity__c field exists\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var fields = jsonData.fields;",
                  "    var field = fields.find(function(f) { return f.name === 'Upsell_Opportunity__c'; });",
                  "    pm.expect(field).to.not.be.undefined;",
                  "    pm.expect(field.name).to.equal('Upsell_Opportunity__c');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
