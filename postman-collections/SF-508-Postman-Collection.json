      "name": "Field Existence Verification",
      "item": [
        {
          "name": "SF-508-API-001 - Describe Opportunity Object",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"Win_reason_details__c field exists on Opportunity\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    var fields = jsonData.fields;",
                  "    ",
                  "    // Debug: Log all field names to help identify the correct field name",
                  "    var fieldNames = fields.map(function(f) { return f.name; });",
                  "    var winReasonFields = fieldNames.filter(function(name) { return name.toLowerCase().includes('win') && name.toLowerCase().includes('reason'); });",
                  "    ",
                  "    if (winReasonFields.length > 0) {",
                  "        console.log('⚠️ Found similar fields: ' + winReasonFields.join(', '));",
                  "    }",
                  "    ",
                  "    var field = fields.find(function(f) { return f.name === 'Win_reason_details__c'; });",
                  "    ",
                  "    if (!field) {",
                  "        // Try alternative field names",
                  "        field = fields.find(function(f) { return f.name === 'Win_Reason_Details__c'; });",
                  "    }",
                  "    if (!field) {",
                  "        field = fields.find(function(f) { return f.name.toLowerCase() === 'win_reason_details__c'; });",
                  "    }",
                  "    ",
                  "    if (!field) {",
                  "        console.error('❌ Field Win_reason_details__c not found');",
                  "        console.error('Total fields in Opportunity: ' + fields.length);",
                  "        console.error('Sample field names (first 20): ' + fieldNames.slice(0, 20).join(', '));",
                  "        if (winReasonFields.length > 0) {",
                  "            console.error('Similar fields found: ' + winReasonFields.join(', '));",
                  "        }",
                  "    }",
                  "    ",
                  "    pm.expect(field).to.not.be.undefined;",
                  "    pm.expect(field.name).to.equal('Win_reason_details__c');",
                  "    console.log('✅ Win_reason_details__c field found');",
                  "    console.log('Field Type: ' + field.type);",
                  "    console.log('Field Label: ' + field.label);",
                  "    if (field.required !== undefined) {",
                  "        console.log('Required: ' + field.required);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/services/data/{{api_version}}/sobjects/Opportunity/describe",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "services",
                "data",
                "{{api_version}}",
                "sobjects",
                "Opportunity",
                "describe"
              ]
            },
            "description": "Verify Win_reason_details__c field exists on Opportunity object\n\n**Test:** SF-508-API-001\n**Purpose:** Field existence verification"
          },
          "response": []
        }
      ]
