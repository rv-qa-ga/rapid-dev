							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Response contains records\", function () {",
							"    var jsonData = pm.response.json();",
							"    pm.expect(jsonData).to.have.property('records');",
							"    pm.expect(jsonData.records).to.be.an('array');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/services/data/{{api_version}}/query/?q=SELECT Id, Name, Investment_Status_c__c FROM Account LIMIT 10",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"services",
						"data",
						"{{api_version}}",
						"query",
						""
					],
					"query": [
						{
							"key": "q",
							"value": "SELECT Id, Name, Investment_Status_c__c FROM Account LIMIT 10"
						}
					]
				},
				"description": "API - Query Account by Investment_Status_c\n\n**Test ID:** SF-484-API-004\n**Priority:** p2\n**Tags:** @api-query\n\n**Prerequisite:** Requires an existing Account record"
			},
			"response": []
		},
		{
			"name": "SF-484-API-005 - Reject invalid Investment_Status_c__c value",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code indicates error\", function () {",
							"    pm.expect(pm.response.code).to.be.oneOf([400, 422]);",
							"});",
							"",
							"pm.test(\"Error response mentions Investment_Status_c\", function () {",
							"    var jsonData = pm.response.json();",
							"    var errorText = JSON.stringify(jsonData);",
							"    pm.expect(errorText.toLowerCase()).to.include('investment_status_c');",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"Name\": \"Invalid Test Account\",\n  \"Investment_Status_c__c\": \"INVALID_VALUE_###\"\n}",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
				"url": {
					"raw": "{{base_url}}/services/data/{{api_version}}/sobjects/Account/",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"services",
						"data",
						"{{api_version}}",
						"sobjects",
						"Account",
						""
					]
				},
				"description": "API - Reject invalid Investment_Status_c__c value\n\n**Test ID:** SF-484-API-005\n**Priority:** p2\n**Tags:** @negative @invalid-value\n\n**Expected:** API should reject invalid Investment_Status_c__c value and return error mentioning \"Investment_Status_c\""
			},
			"response": []
		},
		{
			"name": "SF-484-API-006 - Handle null Investment_Status_c__c value",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test(\"Investment_Status_c__c is null or empty\", function () {",
							"    var jsonData = pm.response.json();",
							"    if (jsonData.records && jsonData.records.length > 0) {",
							"        var record = jsonData.records[0];",
							"        pm.expect(record.Investment_Status_c__c === null || record.Investment_Status_c__c === '' || record.Investment_Status_c__c === undefined).to.be.true;",
							"    }",
							"});"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{base_url}}/services/data/{{api_version}}/query/?q=SELECT Id, Name, Investment_Status_c__c FROM Account WHERE Investment_Status_c__c = null LIMIT 1",
					"host": [
						"{{base_url}}"
					],
					"path": [
						"services",
						"data",
						"{{api_version}}",
						"query",
						""
					],
					"query": [
						{
							"key": "q",
							"value": "SELECT Id, Name, Investment_Status_c__c FROM Account WHERE Investment_Status_c__c = null LIMIT 1"
						}
					]
				},
				"description": "API - Handle null Investment_Status_c__c value\n\n**Test ID:** SF-484-API-006\n**Priority:** p2\n**Tags:** @negative @null-value\n\n**Prerequisite:** Requires a test Account created via API without Investment_Status_c"
			},
