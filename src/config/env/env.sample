#
# Sample environment file (do not commit real credentials)
# Copy the contents of this file into `src/config/env/.env.<env>`
# (for example `.env.qa`) and fill in the values locally.
#

# ═══════════════════════════════════════════════════════════════════════════
# SHARED JWT CONFIGURATION (Same for ALL users)
# ═══════════════════════════════════════════════════════════════════════════
# These settings are shared across all user roles - you only need ONE connected app
# 
# IMPORTANT: One Connected App can be used for multiple users!
# - Same Consumer Key (SF_JWT_CLIENT_ID) for all users
# - Same certificate/private key for all users
# - Only the username changes per role
#
# Setup Steps:
# 1. Create ONE Connected App in Salesforce (if not already created)
# 2. Upload your certificate to the Connected App
# 3. Authorize each user for the Connected App (or set policy to "All users may self-authorize")
# 4. Configure user-specific usernames below (SF_{ROLE}_JWT_USERNAME)
# ═══════════════════════════════════════════════════════════════════════════

# Consumer Key from your Salesforce Connected App (same for all users)
SF_JWT_CLIENT_ID=your_salesforce_consumer_key

# Certificate/Private Key (same for all users)
# Option 1: Use certificate file
SF_CERT_PATH=certs/server.key
# Option 2: Use private key directly in environment variable (alternative to file)
SF_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...key...\n-----END PRIVATE KEY-----"

# Salesforce Instance URLs (same for all users)
SF_BASE_URL=https://your-instance.my.salesforce.com
SF_LOGIN_URL=https://your-instance.my.salesforce.com

# ═══════════════════════════════════════════════════════════════════════════
# ADMIN USER (Default/System Administrator)
# ═══════════════════════════════════════════════════════════════════════════
SF_JWT_USERNAME=automation.user@example.com.qa

# ═══════════════════════════════════════════════════════════════════════════
# Per-object field strip list (used by TestDataFactory.filterToExistingFields).
# Use for fields present in QA but not yet deployed to UAT (or vice-versa),
# or for fields that linger in describe metadata but are rejected on insert.
# Takes effect BEFORE the describe-based filter.
# Comma-separated field API names per SObject (uppercase object, strip `__c`).
# ═══════════════════════════════════════════════════════════════════════════
# SF_SKIP_FIELDS_ACCOUNT=Reporting_Region__c
# SF_SKIP_FIELDS_LEAD=Reporting_Region__c
# SF_SKIP_FIELDS_CONTACT=Reporting_Region__c
# SF_SKIP_FIELDS_OPPORTUNITY=Reporting_Region__c
# SF_SKIP_FIELDS=Some_Global_Field__c   # applies to every object

# Force-include fields that the describe-based filter would otherwise drop
# (useful for dependent picklists whose visibility is context-sensitive):
# SF_ALLOW_FIELDS_OPPORTUNITY=Sub_Type__c
# SF_ALLOW_FIELDS=Some_Field_Always_Kept__c

# Env-specific default picklist values (applied only when the test data does
# not already include the field). Use when a field is auto-defaulted by flow
# in one org but REST API requires it explicitly in another.
# SF_DEFAULT_OPPORTUNITY_TYPE=New Customer
# SF_DEFAULT_OPPORTUNITY_SUB_TYPE=Rate & Commission Changes
# SF_DEFAULT_LEAD_TYPE__c=Member
# SF_DEFAULT_LEAD_STATUS=Open - Not Contacted

# QA→UAT Salesforce org parity (npm run test:sf:parity:qa-uat): UAT JWT is read from src/config/env/.env.uat (SF_JWT_USERNAME there).
# Optional override from this file if you do not want UAT username in .env.uat:
# SF_PARITY_UAT_JWT_USERNAME=automation.user@example.com.uat
#
# Excel inventory report (npm run test:sf:parity:report) — optional:
# SF_PARITY_REPORT_OUTPUT=reports/sf-org-parity/my-parity.xlsx
# SF_PARITY_REPORT_DIR=reports/sf-org-parity/custom-dir  # directory used by per-scenario artifacts from the After hook
# SF_PARITY_REPORT_OBJECTS=all          # or "custom" for custom-flag SObjects only
# SF_PARITY_REPORT_EXCLUDE_PREFIXES=sf_devops__   # comma-separated name prefixes to omit from report
# SF_PARITY_REPORT_FIELD_DIFF_MAX=0       # set e.g. 50 to add sheet "CustomFieldDiffs" for first 50 objects in BOTH orgs (2× describes each; slow at scale)
# SF_PARITY_REPORT_PERMISSION_SETS=true   # set "false" to skip PermissionSets sheet
# Optional: use a different user for API tests only (e.g. describe Opportunity Readiness as MRD)
# SF_API_JWT_USERNAME=qa.mrd.user@example.com.qa
# SF-923 / MuleSoft: integration JWT user for Dataverse_ID__c FLS describe + API-003/006 (same connected app as other JWT users unless documented otherwise)
# SF_MULESOFT_INTEGRATION_JWT_USERNAME=mulesoft.integration@example.com.qa
# Custom Metadata SOQL (CustomMetadataValidator): when SF_MULESOFT_INTEGRATION_JWT_USERNAME is set, CMDT queries use that JWT unless overridden by SF_CMDT_QUERY_JWT_USERNAME
# SF_CMDT_QUERY_JWT_USERNAME=mulesoft.integration@example.com.qa
# Or: SF_USE_QA_MRD_FOR_API=true  (uses SF_QAMRDUSER_JWT_USERNAME for API client)
# Legacy password authentication (fallback, not recommended)
SF_USERNAME=legacy-username@example.com
SF_PASSWORD=REPLACE_ME
SF_SECURITY_TOKEN=REPLACE_ME
SF_USER_PERMISSIONS=System_Admin,API_User

# Salesforce - Standard User (non-admin, for permissions testing)
# Used by step: "Given I am logged in as a standard user"
# Legacy pattern (still supported): SF_STANDARD_USER_*
SF_STANDARD_USER_USERNAME=standard.user@example.com.qa
SF_STANDARD_USER_PASSWORD=REPLACE_ME
SF_STANDARD_USER_SECURITY_TOKEN=REPLACE_ME
SF_STANDARD_USER_JWT_USERNAME=standard.user@example.com.qa
# New pattern (recommended): SF_STANDARDUSER_* (no spaces/hyphens in role name)
SF_STANDARDUSER_JWT_USERNAME=standard.user@example.com.qa
SF_STANDARDUSER_USERNAME=standard.user@example.com.qa
SF_STANDARDUSER_PASSWORD=REPLACE_ME
SF_STANDARDUSER_SECURITY_TOKEN=REPLACE_ME

# Salesforce - QA MRD User (Member Relationship Director)
# Used by step: "Given I am logged in as a \"QA MRD User\" user"
# Maps from Jira mentions: "MRD", "Member Relationship Director", "QA MRD User"
# Role name is normalized: "QA MRD User" -> SF_QAMRDUSER_*
SF_QAMRDUSER_JWT_USERNAME=qa.mrd.user@example.com.qa

# QA Actuary user (JWT) — SF-977 API Background: "API token as QA Actuary user"
SF_QAACTUARYUSER_JWT_USERNAME=qa.actuary.user@example.com.qa
# Alternative: Password authentication (if JWT not available)
SF_QAMRDUSER_USERNAME=qa.mrd.user@example.com.qa
SF_QAMRDUSER_PASSWORD=REPLACE_ME
SF_QAMRDUSER_SECURITY_TOKEN=REPLACE_ME

# SF-883 API feature: Background step "API token as QA MRD user" requires SF_QAMRDUSER_JWT_USERNAME (connected app pre-auth).
# SF-883 API/UI — Opportunity Sub Type & Rate & Commission Changes (optional; describe/env overrides)
# In UI: Sub Type applies when Type = Expansion; commission + comments fields show when Sub Type = Rate & Commission Changes.
# API tests default Type to Expansion so Sub_Type__c and RAC validation can run; do not set SF883_OPPORTUNITY_TYPE to another
# value unless your org maps the same rules to that type.
# SF883_SUB_TYPE_API_FIELD=Sub_Type__c
# SF883_OPPORTUNITY_TYPE=Expansion
# SF883_OTHER_SUBTYPE=New Product
# SF883_CONTRACTING_STAGE=Contracting
# SF883_COMMENTS_FIELD=UpdatedCommissionRateAdditionalCmts__c

# SF-977 API — Product Map lifecycle for Expansion opportunities (picklist/stage labels vary by org)
# Background: dual clients — QA automation JWT for Opportunity describe/Tooling (Sub Type); SF_QAACTUARYUSER_JWT_USERNAME for creates (TestDataFactory + apiClient).
# SF977_ACCOUNT_TYPE=Member
# Must be exactly "Member" or "Non Member MGA" (Account Type picklist). Use Non Member MGA to exercise that path.
# SF977_OPPORTUNITY_TYPE=Expansion
# UI/tests sometimes use "Expansions"; set to match your Opportunity Type picklist API value.
# When Type is Expansion, QA often requires Sub Type (same as SF-883). Defaults reuse SF883_OTHER_SUBTYPE / Sub_Type__c.
# SF977_EXPANSION_SUB_TYPE=New Product
# SF977_EXPANSION_SUB_TYPE_FIELD=Sub_Type__c
# If unset, SF-977 discovers a createable Sub Type field from Opportunity describe.
# SF977_SKIP_EXPANSION_SUB_TYPE=true — omit Sub Type on create (only if your org has no rule)
# SF977_OPPORTUNITY_STAGE_LIVE=Live
# Stage before moving to Live (automation updates Opp then waits for Product Map activation)
# SF977_PRE_LIVE_STAGE=Go-Live
# SF977_PRODUCT_MAP_STATUS_DRAFT=Draft - Product Expansion
# SF977_PRODUCT_MAP_STATUS_PENDING=Active - Pending Go-Live
# SF977_PRODUCT_MAP_STATUS_ACTIVE=Active
# SF977_PRODUCT_MAP_STATUS_INACTIVE=Inactive
# SF977_PRODUCT_MAP_STATUS_FIELD=Status__c
# SF977_PRODUCT_MAP_OPPORTUNITY_LOOKUP=Opportunity__c
# SF977_PRODUCT_MAP_ACCOUNT_LOOKUP=Account__c
# SF977_ASYNC_WAIT_MS=120000
# Auto / display id on Product Map (SF-976 style checks):
# SF977_PRODUCT_MAP_AUTO_ID_FIELD=Product_Map_Id__c
#
# Product_Map__c — QA field API names (from record page / layout inspector), for UI + API alignment:
# Name, Product_Map_Id__c, Account__c, Product__c, Status__c, Effective_Start_Date__c, Effective_End_Date__c,
# Country__c, Non_renewable__c, OwnerId, Line_of_Business__c, Opportunity__c
#
# SF-977 UI — New Product Map (Accelerant Console). QA data limitation until catalog expands:
# Product lookup (Product__c) must stay "test" unless you override SF977_UI_ALLOWED_PRODUCT_LABEL.
# SF977_UI_PRODUCT_LOOKUP_FIELD=Product__c
# SF977_UI_OPPORTUNITY_LOOKUP_FIELD=Opportunity__c
# SF977_UI_PRODUCT_MAPS_NAV_LABEL=Product Maps
# SF977_UI_ALLOWED_PRODUCT_LABEL=test
# SF977_UI_PRODUCT_MAP_NAME_PREFIX=SF977_PM_UI
# (Alternate field label in some orgs: Updated_Commission_Rate_Additional_Cmts__c)
# SF883_DISTRIBUTION_REGION=US

# ManCo test data (npm run data:manco-test) — EU/UK only; see scripts/generate-manco-test-data.ts
# Ground rules: SF_QAMRDUSER_JWT_USERNAME is required — all creates/updates/query/submit run as QA MRD User.
# Opportunity Readiness approvers by Members Operating Region — docs/OPPORTUNITY_READINESS_APPROVERS_BY_REGION.md
# US: scripts use only the FIRST username (one approval step). UK/EU/CA: list every approver in order (each step approved).
# Canonical env (legacy CONTRACTING_* names still work if these are unset):
# OPPORTUNITY_READINESS_APPROVAL_PROCESS_NAME=Opportunity Readiness Approval
# If submit returns NO_APPLICABLE_PROCESS, use ProcessDefinition Id (npm run data:list-readiness-approval-processes):
# OPPORTUNITY_READINESS_APPROVAL_PROCESS_ID=
# OPPORTUNITY_APPROVER_USERNAMES_US=aaron.dicaprio@accelins.com.qa,...   # first user only is used by scripts
# OPPORTUNITY_APPROVER_USERNAMES_UK=matthew.wood@accelins.com.qa,nick.brown@accelins.com.qa
# OPPORTUNITY_APPROVER_USERNAMES_EU=gabriella.engstrand@accelins.com.qa,raquel.reneses@accelins.com.qa
# Optional ManCo-only overrides (checked before OPPORTUNITY_*):
# MANCO_READINESS_APPROVAL_PROCESS_NAME=Opportunity Readiness Approval
# MANCO_APPROVER_USERNAMES_UK=...
# MANCO_APPROVER_USERNAMES_EU=...
# POG committee approval (process name must match your org; approvers = JWT users who can approve)
# MANCO_POG_APPROVAL_PROCESS_NAME=
# MANCO_POG_APPROVER_USERNAMES_UK=
# MANCO_POG_APPROVER_USERNAMES_EU=
# Context for optional POG submit API: readiness | opportunity (default readiness)
# MANCO_POG_SUBMIT_CONTEXT=readiness
# ManCo utility — Account Broker_Sourced__c (Yes/No), default Yes
# MANCO_BROKER_SOURCED=Yes
# Legacy alias:
# MANCO_LEAD_BROKER_SOURCED__c=Yes
# Opportunity Type after Lead convert — QA picklist is New Business | Expansion (default New Business; UI may label as New Member)
# MANCO_OPPORTUNITY_TYPE=New Business
# USE_QA_MRD_AS_OWNER=true — recommended so Account/Opportunity OwnerId matches QA MRD creator

# SF-788 API — Account Relationship (TPA Maps) Platform Events
# SF788_PLATFORM_EVENT_CHANNEL=/event/Account_Relationship_Event__e
# SF788_PLATFORM_EVENT_TIMEOUT_MS=180000
# SF788_USE_ACCOUNT_RELATIONSHIP_OBJECT=false
# SF788_TPA_MAPS_OBJECT_API_NAME=TPA_Maps__c

# SF-612 / SF-769 — Member Legal Entity Relationship Platform Events (CometD)
# SF612_MLER_PLATFORM_EVENT_CHANNEL=/event/Member_Legal_Entity_Relationship_Event__e
# SF612_MLER_PLATFORM_EVENT_API_NAME=Member_Legal_Entity_Relationship_Event__e
# SF-769 — MLER + Group__c; default channel matches SF-612 MLER event unless you set overrides below
# SF769_PLATFORM_EVENT_CHANNEL=/event/Member_Legal_Entity_Relationship_Event__e
# SF769_PLATFORM_EVENT_API_NAME=Member_Legal_Entity_Relationship_Event__e
# SF769_PLATFORM_EVENT_TIMEOUT_MS=180000
# SF-769 API-008 — OData entity set + field that stores Salesforce MLER Id after sync
# SF769_DYNAMICS_MEMBER_MAPS_ENTITY_SET=your_member_maps_entityset
# SF769_DYNAMICS_CORRELATION_FIELD=your_salesforce_relationship_id_field
# SF769_SKIP_CLEANUP=true — keep Accounts + MLER created during @SF-769 runs (AfterAll no-delete); use while comparing API vs UI Group / Mule logs
# npm run test:sf769:keep-data:qa-mrd — same as keep-data + ENV=qa + SF_USE_QA_MRD_FOR_API=true (API as QA MRD User; requires SF_QAMRDUSER_JWT_USERNAME on connected app)

# SF-736 / MuleSoft — Salesforce Account ↔ Dynamics Party field API names per org (qamerge may differ)
# ACCOUNT_DATAVERSE_ID_FIELD=Dataverse_Id__c
# SF_ACCOUNT_DATAVERSE_ID_FIELD=Dataverse_Id__c   # optional alias
# ACCOUNT_PARTY_MASTER_ID_FIELD=Party_MasterId__c
# Account REST: standard Account often has no "Email"; map or omit → ACCOUNT_REST_EMAIL_FIELD=PersonEmail (or omit skip)
# ACCOUNT_REST_EMAIL_FIELD=
# Account Platform Events (CometD) channel if not /event/Account__e:
# ACCOUNT_PLATFORM_EVENT_CHANNEL=/event/Account__e
# E2E_ACCOUNT_PLATFORM_EVENT_CHANNEL=/event/Account__e

# Legacy: SF_MRD_* (for backward compatibility if needed)
# SF_MRD_JWT_USERNAME=qa.mrd.user@example.com.qa

# Salesforce - Non-Admin User
# Used by step: "Given I am logged in as a \"Non-Admin User\" user"
# Role name is normalized: "Non-Admin User" -> SF_NONADMINUSER_*
SF_NONADMINUSER_JWT_USERNAME=qa.nonadmin.user@example.com.qa
SF_NONADMINUSER_USERNAME=qa.nonadmin.user@example.com.qa
SF_NONADMINUSER_PASSWORD=REPLACE_ME
SF_NONADMINUSER_SECURITY_TOKEN=REPLACE_ME

# Salesforce - Read-Only User
# Used by step: "Given I am logged in as a read-only user"
# Role name is normalized: "read-only user" -> SF_READONLYUSER_*
SF_READONLYUSER_JWT_USERNAME=qa.readonly.user@example.com.qa
SF_READONLYUSER_USERNAME=qa.readonly.user@example.com.qa
SF_READONLYUSER_PASSWORD=REPLACE_ME
SF_READONLYUSER_SECURITY_TOKEN=REPLACE_ME

# Salesforce - Data Governance User (SF-872 reference-data governance)
# UI: "Given I am logged in as a \"Data Governance\" user" → maps to Data Governance User → SF_DATAGOVERNANCEUSER_*
# API: "Given I have a valid Salesforce API token as Data Governance user" → SF_DATAGOVERNANCEUSER_JWT_USERNAME
SF_DATAGOVERNANCEUSER_JWT_USERNAME=qa.data.governance@example.com.qa
SF_DATAGOVERNANCEUSER_USERNAME=qa.data.governance@example.com.qa
SF_DATAGOVERNANCEUSER_PASSWORD=REPLACE_ME
SF_DATAGOVERNANCEUSER_SECURITY_TOKEN=REPLACE_ME

# SF-872 reference data creates (SF-872-data.feature): optional Product2 Id for Lookup(Product)
# SF_SF872_PRODUCT2_ID=01txxxxxxxxxxxxx

# Additional User Roles
# You can add any role by following the pattern: SF_{NORMALIZED_ROLE}_*
# Examples:
#   "Sales Manager" -> SF_SALESMANAGER_JWT_USERNAME
#   "Account Executive" -> SF_ACCOUNTEXECUTIVE_JWT_USERNAME
#   "Support Agent" -> SF_SUPPORTAGENT_JWT_USERNAME
#
# Role name normalization rules:
#   - Convert to uppercase
#   - Remove spaces, hyphens, underscores
#   - Example: "Non-Admin User" -> "NONADMINUSER"
#
# Usage in feature files:
#   Given I am logged in as a "MRD" user
#   Given I am logged in as a "Non-Admin User" user
#   Given I am logged in as a "Sales Manager" user

# Jira
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=automation.user@example.com
JIRA_API_TOKEN=REPLACE_ME
# Optional aliases (same value as API token; framework accepts any one of these):
# JiraAutomationToken=REPLACE_ME
# JIRA_AUTOMATION_TOKEN=REPLACE_ME
# ATLASSIAN_API_TOKEN=REPLACE_ME   # also used for Confluence
# Verify: npm run jira:verify-token
JIRA_REJECT_UNAUTHORIZED=false

# Zephyr Scale
ZEPHYR_BASE_URL=https://your-domain.atlassian.net
ZEPHYR_PROJECT_KEY=SF
ZEPHYR_API_TOKEN=REPLACE_ME
ZEPHYR_REJECT_UNAUTHORIZED=false

# After each Cucumber run, copy reports/json/cucumber-report.json to reports/json/archive/cucumber-report-{work}-{timestamp}.json
# Work id: from ARCHIVE_WORK_ITEM, or inferred from tags like @SF-883-API-001 (multiple → joined with _).
# ARCHIVE_CUCUMBER_JSON=true
# ARCHIVE_WORK_ITEM=SF-883

# Confluence (for test evidence storage)
# Evidence is uploaded to Confluence and linked from Zephyr test executions
CONFLUENCE_BASE_URL=https://accelins.atlassian.net/wiki
CONFLUENCE_SPACE_KEY=TM
CONFLUENCE_PARENT_FOLDER_ID=2720628759
# Lloyd's QA progress (R/Y/G) — when set, upload script updates this page instead of resolving by parent + title
# https://accelins.atlassian.net/wiki/spaces/TM/pages/3220078705/QA+progress+R+Y+G
# CONFLUENCE_LLOYDS_QA_PROGRESS_PAGE_ID=3220078705
#
# Lloyd's QA progress — Mermaid → Confluence (see npm run docs:upload:lloyds-qa-progress)
# Default: upload SVG as page attachments + ac:image (visible in Cloud). Inline SVG often hidden.
# LLOYDS_CONFLUENCE_MERMAID_INLINE_SVG=1
# LLOYDS_CONFLUENCE_MERMAID_ATTACHMENT_MACRO=0
# Knowledge hub parent (TM): https://accelins.atlassian.net/wiki/spaces/TM/pages/1961787450
# CONFLUENCE_KNOWLEDGE_BASE_PARENT_ID=1961787450
# Uses same credentials as Jira (ATLASSIAN_EMAIL/ATLASSIAN_API_TOKEN or JIRA_EMAIL/JIRA_API_TOKEN)
# For setup script scripts/setup/create-knowledge-base-subpages.ts, prefer secrets in src/config/env/.env.qa or .env.qa
# Optional: comma-separated page IDs to merge as read-only reference text into Salesforce knowledge MD (no writes; any space)
# CONFLUENCE_KNOWLEDGE_REFERENCE_PAGE_IDS=2412675671
# Optional: TM "Salesforce core functions" child page ID (after hub setup) — for docs/scripts that link to it
# CONFLUENCE_TM_SALESFORCE_KNOWLEDGE_PAGE_ID=3146645519
# TM Salesforce KB sync (scripts/knowledge/sync-tm-salesforce-kb-capability.ts — --capability leads|account|opportunity|…)
# npm run confluence:sync:tm-sf-kb-leads   |   :missing-only
# npm run confluence:sync:tm-sf-kb-account  |   :missing-only
# npm run confluence:sync:tm-sf-kb-opportunity  |   :missing-only
# Push template bodies from repo (overwrite existing + create missing, no prompts): add -- --apply-updates

# Atlassian credentials (shared for Jira, Zephyr, and Confluence)
ATLASSIAN_EMAIL=your-email@company.com
ATLASSIAN_API_TOKEN=REPLACE_ME
# Cursor MCP: scripts/run-atlassian-mcp-from-env.mjs loads src/config/env/.env.qa by default and connects to Atlassian Rovo MCP (Jira/Confluence/Compass).
# Optional: path to another env file. Rovo may require an MCP-scoped API token if your org enables token auth (see Atlassian Rovo MCP docs).
# CURSOR_MCP_ENV_FILE=src/config/env/.env.qa
# Optional overrides:
# ATLASSIAN_MCP_SITE_URL=https://your-domain.atlassian.net
# ATLASSIAN_MCP_URL=https://mcp.atlassian.com/v1/mcp

# Reporting / Execution
HEADLESS=false

# ═══════════════════════════════════════════════════════════════════════════
# DYNAMICS 365 CRM (DATAVERSE) CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# OAuth2 Client Credentials authentication for Dynamics 365
# Uses Service Principal (SPN) for authentication
#
# Required: D365_TENANT_ID, D365_CLIENT_ID, D365_CLIENT_SECRET, D365_SCOPE
# Optional: D365_BASE_URL, D365_WEB_API_BASE_URL
# ═══════════════════════════════════════════════════════════════════════════

# Azure AD Tenant ID (GUID)
D365_TENANT_ID=your-tenant-id-guid

# Azure AD App Registration (Service Principal) Client ID
D365_CLIENT_ID=your-client-id-guid

# Azure AD App Registration Client Secret
D365_CLIENT_SECRET=your-client-secret

# OAuth2 Scope (typically: https://<org>.crm11.dynamics.com/.default)
D365_SCOPE=https://accelinsqatest.crm11.dynamics.com/.default

# CLM Go-Live INT (pre-prod migration + integration) — copy into src/config/env/.env.int:
# ENV=int
# SF_BASE_URL=https://arx--int.sandbox.my.salesforce.com
# SF_LOGIN_URL=https://arx--int.sandbox.my.salesforce.com
# D365_BASE_URL=https://accelinspreprod.crm11.dynamics.com
# D365_WEB_API_BASE_URL=https://accelinspreprod.crm11.dynamics.com/api/data/v9.2/
# D365_SCOPE=https://accelinspreprod.crm11.dynamics.com/.default
# MULESOFT_ORG_ID / MULESOFT_ENV_ID — INT Mule apps (not qamerge)
# SF_DATA_CLOUD_API_BASE=...
# BORDEREAUX_TEST_FILE_WRITTEN=...  BORDEREAUX_TEST_FILE_CLAIM=...  BORDEREAUX_TEST_MEMBER_MASTER_ID=...
# PreProd automation access for all rows below is PENDING (programme IAM) — see plan § PreProd automation access
# Plan: docs/clm/CLM_GO_LIVE_MIGRATION_INTEGRATION_TEST_PLAN.md
#
# CLM migration validation (Phase A — read-only on INT):
# CLM_MIGRATION_GONOGO_FULL_TABLE=true   — default; skipped/not-loaded entities fail A2 Go/No-Go
# CLM_MIGRATION_COUNT_READY_ONLY=false   — when true, A2 counts only @int-migration-ready entities
# CLM_MIGRATION_STRICT=true              — fail scenarios on count/field/audit mismatches
# CLM_MIGRATION_MAX_RECORDS=0              — 0/all = full population; set 25 for smoke
# CLM_MIGRATION_USER_MAPPING_CSV=          — optional DV→SF user map CSV (overrides Azure AD probe)
# CLM_MIGRATION_CORRELATION_FIELD=         — force correlation field for all objects (else probed)
# ACCOUNT_DATAVERSE_ID_FIELD=Dataverse_ID__c — Account only (else probed)

# Dynamics 365 Base URL (optional - can be set in JSON config)
# D365_BASE_URL=https://accelinsqatest.crm11.dynamics.com

# Playwright goto timeout for Dynamics UI login (ms, default 90000)
# D365_UI_GOTO_TIMEOUT_MS=120000

# Direct RDM app URL (optional). Default: <D365_BASE_URL>/Apps/uniquename/accelins_ReferenceData
# DYNAMICS_RDM_APP_URL=https://accelinsqatest.crm11.dynamics.com/Apps/uniquename/accelins_ReferenceData

# If true, open RDM via Published Apps grid + "Reference Data Management" tile instead of the direct app URL above
# DYNAMICS_RDM_USE_PUBLISHED_APPS_TILE=true

# Legacy: if your org still used main.aspx?appid=..., prefer DYNAMICS_RDM_APP_URL instead
# DYNAMICS_RDM_USE_DEEP_LINK=true

# Max time to wait for Published Apps UI markers after main.aspx (ms, default 60000)
# D365_PUBLISHED_APPS_WAIT_MS=90000

# First Playwright navigation after SPN auth. Default: <D365_BASE_URL>/Apps/uniquename/accelins_ReferenceData (same as DYNAMICS_RDM_APP_URL).
# Set only if you need a different landing page than the RDM app URL.
# D365_UI_ENTRY_URL=https://yourorg.crm.dynamics.com/Apps/uniquename/your_rdm_app

# ─── Dynamics UI authentication mode (Playwright model-driven UI) ───
# spn — default: client credentials (D365_*) inject Bearer header on Dynamics host (application user required).
# interactive — Entra ID password UX (no SPN Bearer on browser); use licensed automation account with CA/MFA permissive policy.
#
# DYNAMICS_UI_AUTH_MODE=interactive
#
# Credentials for interactive UI only (do not commit; set in src/config/env/.env.qa etc.):
# D365_UI_USERNAME=svc-d365-ui-automation-qa@accelins.com
# D365_UI_PASSWORD=REPLACE_ME
# Legacy alias accepted: D365_SVC_PASSWORD or D365_SVC_Password (prefer D365_UI_PASSWORD).
#
# Aliases supported: D365_UI_AUTH_MODE, D365_INTERACTIVE_USERNAME, D365_INTERACTIVE_PASSWORD.
# Timeout for completing Microsoft login (ms, default 180000): D365_UI_LOGIN_TIMEOUT_MS=240000

# Dynamics 365 Web API Base URL (optional - defaults to <baseUrl>/api/data/v9.2/)
# D365_WEB_API_BASE_URL=https://accelinsqatest.crm11.dynamics.com/api/data/v9.2/

# ─── Dynamics 365 Finance & Operations web client (scripts/dynamics-fno-aumi-login-smoke.ts) ───
# D365_FO_UI_BASE_URL=https://yourtenant.sandbox.operations.dynamics.com
# D365_FO_UI_ENTRY_URL=https://yourtenant.sandbox.operations.dynamics.com/?cmp=yourdataarea&mi=defaultdashboard
# D365_FO_DATA_AREA_ID=yourdataarea
# Manual SSO: headed browser — you complete MFA / passwordless (npm run dynamics:fo:aumi-smoke)
# DYNAMICS_FO_USE_MANUAL_SSO=true
# DYNAMICS_FO_SSO_EMAIL=you@yourorg.com
# DYNAMICS_FO_MANUAL_SSO_TIMEOUT_MS=300000
# After login, script lists legal-entity data area IDs via OData LegalEntities (browser cookies, then D365_* SPN):
# DYNAMICS_FO_LIST_LEGAL_ENTITIES=true
# D365_FO_ODATA_SCOPE=https://yourtenant.sandbox.operations.dynamics.com/.default

# ═══════════════════════════════════════════════════════════════════════════
# LLOYD'S — AZURE SERVICE BUS (DEV SMOKE / scripts/lloyds/send-mule-xml-generation-test-message.ts)
# ═══════════════════════════════════════════════════════════════════════════
# Entra app needs **Azure Service Bus Data Sender** on namespace sb-dev-uks-lyd (or target queue).
# Message contract: ISDE → Service Bus | Messages (Sample messages)
# https://accelins.atlassian.net/wiki/spaces/ISDE/pages/3118760006/Service+Bus+Messages#Sample-messages
#
# LLOYDS_SERVICE_BUS_TENANT_ID=your-tenant-guid
# LLOYDS_SERVICE_BUS_CLIENT_ID=your-app-client-id
# LLOYDS_SERVICE_BUS_CLIENT_SECRET=your-secret
# Optional overrides (defaults shown):
# LLOYDS_SERVICE_BUS_FQNS=sb-dev-uks-lyd.servicebus.windows.net
# LLOYDS_SERVICE_BUS_QUEUE=mule-xml-generation
# Optional: AMQP send timeout in ms (default 90000). Increase on slow VPN; requires outbound 5671 (or WebSockets) to Azure.
# LLOYDS_SERVICE_BUS_SEND_TIMEOUT_MS=120000
#
# If LLOYDS_SERVICE_BUS_* are unset, the script tries AZURE_TENANT_ID / AZURE_CLIENT_ID / AZURE_CLIENT_SECRET,
# then D365_TENANT_ID / D365_CLIENT_ID / D365_CLIENT_SECRET (only if that app has SB sender on Lloyd's bus).
#
# Optional: override the blob container for the Row-1 sanity discovery. The planner
# (`npm run lloyds:sanity:plan`) lists XML blobs in this container to build the runnable
# test list. Default: https://saaccdevukslyd.blob.core.windows.net/mulesoft-xml
# LLOYDS_BLOB_CONTAINER_URL=https://saaccdevukslyd.blob.core.windows.net/mulesoft-xml
#
# Optional legacy override for the xlsx loader path (`--from-xlsx`). Leave unset unless
# you need to point the (legacy) send path at a different container than the spreadsheet.
# LLOYDS_BLOB_CONTAINER_BASE_URL=
#
# Optional: Dataverse host for the sanity plan discovery. Defaults to D365_BASE_URL.
# Only needed when you want discovery to target a DIFFERENT environment than the one the
# framework's Dynamics tests point at.
# LLOYDS_DATAVERSE_BASE_URL=https://accelinsqatest.crm11.dynamics.com
#
# Optional: force discovery to use the governed SPN instead of interactive user login.
# Set to `true` once the SPN has Dataverse Read + Storage Blob Data Reader (see
# docs/servicenow-ticket-lloyds-spn-permissions.md). Until then, leave unset — discovery
# uses DefaultAzureCredential (run `az login` once).
# LLOYDS_USE_SPN=false
#
# NOTE: the Row-1 sanity test also reads D365_* env vars to query Dataverse for the created
# `accelins_workflows` record. When running the sanity test, D365_BASE_URL / D365_SCOPE /
# D365_WEB_API_BASE_URL must point at the Lloyd's Power Platform env (accelinsqatest), not
# the RDM env (accelinsqatest2). See src/features/lloyds/README.md.
#
# Post-manual-load E2E read-only (`src/features/lloyds/lloyds-pipeline-e2e-readonly.feature`):
# After cleanup (queues, DLQ, blob XML, PROCESS_TRACKER, etc.) and reload, either answer the
# TTY prompt or set this for CI / piped Cucumber (1, true, yes, or y).
# LLOYDS_E2E_READINESS_ACK=1
#
# Default **Dynamics-cloned** repository for single-repo steps (`… configured test repository …` in Cucumber),
# `npm run lloyds:trace:adp-ledger` without `--repo`, etc. Must be one of the **ten** ids in
# `LLOYDS_CLONED_REPOSITORY_IDS` (all **thirteen** Agency ids in `LLOYDS_AGENCY_COHORT_12` have blob/ADP XML; three Power Apps clones still pending for the original twelve-cohort gap list).
# See `lloydsClonedRepoCohort.ts`. When unset: **US-60464**.
# `LLOYDS_E2E_REPO_ID` is a legacy alias read if `LLOYDS_TEST_REPO_ID` is empty.
# LLOYDS_TEST_REPO_ID=US-60464
#
# PP-392 — Snowflake-aligned E2E (`@PP-392-E2E-SNOWFLAKE` in `src/features/api/PP/PP-392.feature`):
# Set **both** to pin Dataverse `accelins_correlation_id` and blob `file_name` to the same production run
# (Snowflake `_ACCEL_UNIQUE_RUN_ID` = middle UUID in WBX/WRX names). Omit both to keep sanity-counter ids.
# Local XML is resolved from `docs/lloyds/XMLs/<file_name>` when present; otherwise the blob is downloaded once.
# Example: `npm run test:pp392:qa:e2e-snowflake`
# LLOYDS_PP392_E2E_CORRELATION_ID=04a80873-3ba1-4caa-9316-d1a0f6ab1b9c
# LLOYDS_PP392_E2E_FILE_NAME=WBX_US-56464_04a80873-3ba1-4caa-9316-d1a0f6ab1b9c_2026-04-27 15-52-00.773.xml
#
# Sanity plan refresh (`npm run lloyds:sanity:plan` / `lloyds:sanity:plan:from-docs-xml`):
# When QA master has no `accelins_legalentity` row for code **AEUM** (filename ledger), map AEUM to an
# existing code (e.g. **AUMI**) so classic `AEUM US-56464 …xml` rows can resolve. Omit when AEUM exists in master.
# LLOYDS_SANITY_LEDGER_ALIAS_AEUM=AUMI
#
# Service Bus **read-only** queue metrics (management API — `getQueueRuntimeProperties`):
# Requires SPN with rights to read queue metadata (not covered by Data Sender alone).
# When unset or not "1"/true/yes, `@lloyds-sb-read` scenarios skip. Run: npm run test:lloyds:e2e-sb-read
# LLOYDS_SB_READ_ENABLED=1
# Optional: override default queue list (comma-separated, programme names on sb-dev-uks-lyd)
# LLOYDS_SB_READ_QUEUES=mule-xml-generation,dv-xml-approval,mule-d365-import,dv-d365-journalposting,mule-dependantproduct

# Optional: after Stage 1, publish synthetic dv-xml-approval-success / mule-xml-submission-success (see lloyds-pipeline-hops).
# LLOYDS_HOP_POST_STAGE1_ENABLED=1

# PP-429 — HTTP func-dimension-validation (full URL to the HTTP trigger; optional Functions key)
# LLOYDS_DIMENSION_VALIDATION_BASE_URL=https://your-function-app.azurewebsites.net/api/validate
# LLOYDS_DIMENSION_VALIDATION_FUNCTION_KEY=
# LLOYDS_PP429_TEST_BLOB_URI=https://.../mulesoft-xml/AEUM%20US-58338%20202604091630.xml
# LLOYDS_PP429_INVALID_DIMENSION_BLOB_URI=
# LLOYDS_PP429_MULTI_PATTERN_BLOB_URI=

# Phase C — Fabric / warehouse TDS: validate XML offset accounts against dbo.dimensionattributevaluecombination
# LLOYDS_FABRIC_DIMENSION_SQL_ENABLED=1

# ENG-44 — optional read-only SQL probes (use SQLSERVER_* host; same SqlServerClient as PROCESS_TRACKER when applicable)
# LLOYDS_ENG44_EXCLUSION_SQL=SELECT COUNT(*) AS c FROM ... WHERE REPOSITORY_ID IN ('US-60507',...)
# LLOYDS_ENG44_RESQ_SQL=

# Umbrella §D–§H narrative scenarios — opt-in before real asserts replace the "skipped" stubs
# LLOYDS_LIVE_DMF_AUTOMATION_ENABLED=1
# LLOYDS_LIVE_POSTING_AUTOMATION_ENABLED=1
# LLOYDS_E2E_TRACE_AUTOMATION_ENABLED=1
# PP-393 DMF narrative scenarios
# LLOYDS_PP393_DMF_AUTOMATION_ENABLED=1

# ═══════════════════════════════════════════════════════════════════════════
# LLOYD'S / FINOPS — SNOWFLAKE (ADP source-of-truth reads)
# ═══════════════════════════════════════════════════════════════════════════
# Used by:
#   - `npm run lloyds:snowflake:probe`  (ADP cohort diagnostic — FOWC/FOWD/FOWD summary)
#   - `npm run test:lloyds:phase2` (Cucumber `@phase-2 @snowflake` — `snowflakeSummaryClient.ts`)
#   - `npm run lloyds:trace:adp-ledger` (JSON trace: ADP → Dataverse workflow → optional SQL below)
#   - `scripts/compare-fowd-agency-xml.ts` (FOWD agency XML comparator, BSG-16)
#
# Target today: same Snowflake account MuleSoft reads from — `accelins-prod`. This is
# **read-only** queries against non-PII Lloyd's FinOps tables.
#
# Entra SPN (preferred — QA NonProd-Automation app; headless / CI):
#   1. SNOWFLAKE_ACCOUNT, SNOWFLAKE_USER (= Snowflake login_name mapped to the app in External OAuth).
#   2. SNOWFLAKE_CLIENT_ID + SNOWFLAKE_CLIENT_SECRET (app registration).
#   3. Token URL: set SNOWFLAKE_OAUTH_TOKEN_REQUEST_URL OR one of SNOWFLAKE_TENANT_ID / D365_TENANT_ID /
#      AZURE_TENANT_ID (defaults to https://login.microsoftonline.com/<tenant>/oauth2/v2.0/token).
#   4. Entra client_credentials **requires** a scope ending in `/.default` for an Application ID URI
#      registered in your tenant. Set either:
#        SNOWFLAKE_OAUTH_SCOPE=https://<resource-app-exposed-api-uri>/.default
#      or SNOWFLAKE_OAUTH_RESOURCE=<that URI without /.default> (framework appends `/.default`).
#      Run `npm run lloyds:snowflake:entra-diagnose` to see AAD error details (invalid_scope / invalid_resource).
#   If OAuth works but Snowflake says your IP is not allowed: account network policy — ask Snowflake admin.
#   `loadFinOpsSnowflakeEnv()` uses dotenv `override: true` so `.env.qa` wins over stale machine SNOWFLAKE_* vars;
#   set FINOPS_SNOWFLAKE_DOTENV_NO_OVERRIDE=1 only if CI must not override pre-injected process.env.
#   Set SNOWFLAKE_PREFER_BROWSER_SSO=1 to force browser login even if client id+secret are present.
#
# Browser SSO (local only): unset SNOWFLAKE_CLIENT_ID and SNOWFLAKE_CLIENT_SECRET, set
# SNOWFLAKE_AUTHENTICATOR=EXTERNALBROWSER. Framework reuses one shared connection per process
# (SNOWFLAKE_REUSE_SHARED_CONNECTION=0 to opt out).
#
# Native Snowflake password: leave client id/secret unset, leave EXTERNALBROWSER unset, set SNOWFLAKE_PASSWORD.
#
# Key-pair JWT: not wired in this repo yet (would use SNOWFLAKE_JWT + private key env — extend snowflake-fetch.ts).
#
# SNOWFLAKE_ACCOUNT=accelins-prod
# SNOWFLAKE_USER=automation_login_name
# SNOWFLAKE_CLIENT_ID=<entra-app-client-id>
# SNOWFLAKE_CLIENT_SECRET=<secret>
# SNOWFLAKE_OAUTH_SCOPE=https://<snowflake-oauth-resource-app-id-uri>/.default
# Optional overrides (defaults in src/utils/fowd-agency-xml-compare/snowflake-fetch.ts):
# SNOWFLAKE_ROLE=PUBLIC
# SNOWFLAKE_WAREHOUSE=INSURANCE_SERVICES_WH
# SNOWFLAKE_DATABASE=FINANCIAL_OPERATIONS
# Optional — Snowflake Node driver logs (see npm run lloyds:snowflake:probe:trace):
# SNOWFLAKE_SDK_LOG_LEVEL=TRACE
# SNOWFLAKE_SDK_LOG_PATH=STDOUT
# Optional — omit `role` on connection (admin / ANY_ROLE experiments): FINOPS_SNOWFLAKE_OMIT_CONNECTION_ROLE=1

# Optional read-only SELECT for `npm run lloyds:trace:adp-ledger` (Fabric warehouse, F&O staging,
# or any TDS endpoint reachable via SQLSERVER_*). Programme supplies the object name — do not guess.
# Placeholders are replaced literally: {REPO}, {RUN_ID}, {CURRENCY} (from latest ADP summary row).
# When set, also configure SQLSERVER_HOST / SQLSERVER_DEFAULT_DB or FABRIC_SQL_DATABASE (see FABRIC block).
# LLOYDS_LEDGER_TRACE_SQL=SELECT TOP 10 * FROM YourSchema.YourLedgerView WHERE RepositoryId = '{REPO}'

# ═══════════════════════════════════════════════════════════════════════════
# AZURE DEVOPS CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Personal Access Token (PAT) authentication for Azure DevOps
#
# Required: AZURE_DEVOPS_ORGANIZATION, AZURE_DEVOPS_PROJECT, AZURE_DEVOPS_PAT
# Optional: AZURE_DEVOPS_BASE_URL, AZURE_DEVOPS_API_VERSION
# ═══════════════════════════════════════════════════════════════════════════

# Azure DevOps Organization name
AZURE_DEVOPS_ORGANIZATION=your-organization

# Azure DevOps Project name
AZURE_DEVOPS_PROJECT=your-project

# Personal Access Token (PAT) - Create at: https://dev.azure.com/{org}/_usersSettings/tokens
# Required scopes: Work Items (Read & Write), Project and Team (Read)
AZURE_DEVOPS_PAT=your-personal-access-token

# Azure DevOps Base URL (optional - defaults to https://dev.azure.com/{organization})
# For Azure DevOps Server (on-premise), use: https://{server}/tfs/{collection}
# AZURE_DEVOPS_BASE_URL=https://dev.azure.com

# API Version (optional - defaults to 7.1)
# AZURE_DEVOPS_API_VERSION=7.1

# ═══════════════════════════════════════════════════════════════════════════
# GITHUB CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# Personal Access Token (PAT) authentication for GitHub
#
# Required: GITHUB_TOKEN
# Optional: GITHUB_BASE_URL (defaults to https://api.github.com)
# ═══════════════════════════════════════════════════════════════════════════

# GitHub Personal Access Token (PAT) - Create at: https://github.com/settings/tokens
# Required scopes: repo (for private repositories), public_repo (for public repositories)
# For organization repositories, ensure token is SSO authorized if required
GITHUB_TOKEN=your-github-personal-access-token

# GitHub API Base URL (optional - defaults to https://api.github.com)
# For GitHub Enterprise Server, use: https://your-github-enterprise-server/api/v3
# GITHUB_BASE_URL=https://api.github.com

# SSL Certificate Verification (optional - defaults to true)
# Set to 'false' only if using self-signed certificates (not recommended for production)
# GITHUB_REJECT_UNAUTHORIZED=false

# ═══════════════════════════════════════════════════════════════════════════
# SQL SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════
# SQL Server connection settings for data validation tests
# Supports multiple databases on the same SQL Server instance
# Uses Microsoft Entra ID (Azure AD) authentication with MFA support
#
# REQUIRED (Azure AD - Recommended):
#   SQLSERVER_HOST, SQLSERVER_TENANT_ID, SQLSERVER_CLIENT_ID, SQLSERVER_CLIENT_SECRET
#
# OPTIONAL:
#   SQLSERVER_PORT, SQLSERVER_DEFAULT_DB
#
# LEGACY (SQL Server Authentication - Deprecated):
#   SQLSERVER_USER, SQLSERVER_PASSWORD (only if Azure AD not configured)
# ═══════════════════════════════════════════════════════════════════════════

# SQL Server hostname or IP address
SQLSERVER_HOST=your-sql-server.example.com

# SQL Server port (default: 1433)
SQLSERVER_PORT=1433

# ═══════════════════════════════════════════════════════════════════════════
# AZURE AD (MICROSOFT ENTRA ID) AUTHENTICATION (Recommended)
# ═══════════════════════════════════════════════════════════════════════════
# Uses Service Principal (SPN) for authentication
# Supports MFA-enabled SQL Server connections
#
# Setup Steps:
# 1. Create an Azure AD App Registration (Service Principal)
# 2. Generate a client secret
# 3. Grant the service principal access to SQL Server
# 4. Configure the credentials below
# ═══════════════════════════════════════════════════════════════════════════

# Azure AD Tenant ID (GUID)
SQLSERVER_TENANT_ID=your-tenant-id-guid

# Azure AD App Registration (Service Principal) Client ID
SQLSERVER_CLIENT_ID=your-client-id-guid

# Azure AD App Registration Client Secret
SQLSERVER_CLIENT_SECRET=your-client-secret

# Default database to connect to (optional, defaults to 'master')
# This is used when no specific database is specified in queries
SQLSERVER_DEFAULT_DB=master

# Lloyd's Mule **control database (Azure SQL Database only)** — `AZURE_SQL_DB_DEV_SERVER` / `AZURE_SQL_DB_DEV_DATABASE`.
# When set, these **override** `SQLSERVER_HOST` / `SQLSERVER_DEFAULT_DB` in merged config so `SqlServerClient` hits
# **`sqldb-dev-uks-lyd`** for `PROCESS_TRACKER` even if a legacy UKS `SQLSERVER_HOST` remains for other scripts.
# This host/db holds Mule-owned tables: **`dbo.PROCESS_TRACKER`**, **`dbo.ERROR_LOG`**, **`dbo.FINANCIAL_AUDIT`**, **`dbo.mule_test`**, etc.
# **Do not** point these vars at the UKS TDS instance — Tagetik / TDS tables use **`SQL_LLOYDS_*`** against **`sql-dev-uks-01.accelins.com`** (e.g. database `TDS`). The programme uses **two SQL surfaces**; the **same Entra SPN** should have access to both where automation runs; use **`DefaultAzureCredential`** (e.g. `az login`) as SSO backup locally.
# Sample: `SELECT * FROM dbo.PROCESS_TRACKER WHERE REPO_ID = 'US-56464';`
# Entra: set `SQLSERVER_TENANT_ID` / `SQLSERVER_CLIENT_ID` / `SQLSERVER_CLIENT_SECRET`, or reuse Dataverse QA SPN (`D365_*` — see `SqlServerClient.ts`).
# AZURE_SQL_DB_DEV_SERVER=sql-dev-uks-lyd.database.windows.net
# AZURE_SQL_DB_DEV_DATABASE=sqldb-dev-uks-lyd

# ═══════════════════════════════════════════════════════════════════════════
# LEGACY SQL SERVER AUTHENTICATION (Deprecated)
# ═══════════════════════════════════════════════════════════════════════════
# Only use if Azure AD authentication is not available
# SQLSERVER_USER=your-sql-username
# SQLSERVER_PASSWORD=your-sql-password

# Note: Database mappings (logical names like "Reporting", "ODS") are configured
# in src/sqlserver/config/databases.json

# ═══════════════════════════════════════════════════════════════════════════
# LLOYD'S — TDS / TAGETIK SQL SERVER (`TagetikWrittenforDataLoaderADP`)
# ═══════════════════════════════════════════════════════════════════════════
# **Separate from SQLSERVER_HOST** (Mule `PROCESS_TRACKER` on e.g. sql-dev-uks-lyd). This block targets
# the TDS database on e.g. **sql-dev-uks-01.accelins.com** for `TDS.tagetik.TagetikWrittenforDataLoaderADP`.
#
# Auth (see `lloydsTagetikTdsClient.ts`):
#   1) Service principal: `SQL_LLOYDS_TENANT_ID` + `SQL_LLOYDS_CLIENT_ID` + `SQL_LLOYDS_CLIENT_SECRET`, OR
#      reuse **`SQLSERVER_*`** SPN when `SQL_LLOYDS_REUSE_SQLSERVER_SPN` is not `0` (default: reuse).
#   2) If SPN is missing or SPN connect fails → **`DefaultAzureCredential`** (e.g. `az login`, VS Code).
#
# Optional: SQL_LLOYDS_TAGETIK_REPO_COLUMN (default RepositoryID), SQL_LLOYDS_TAGETIK_RUN_COLUMN (e.g. _ACCEL_UNIQUE_RUN_ID),
# SQL_LLOYDS_DATABASE (default TDS), SQL_LLOYDS_TAGETIK_SCHEMA (default tagetik), SQL_LLOYDS_TAGETIK_TABLE,
# SQL_LLOYDS_TRUST_SERVER_CERTIFICATE=1 for dev certs, SQL_LLOYDS_ENCRYPT=0 only if required.
# ═══════════════════════════════════════════════════════════════════════════
# SQL_LLOYDS_SERVER=sql-dev-uks-01.accelins.com
# SQL_LLOYDS_SERVER_PORT=1433
# SQL_LLOYDS_DATABASE=TDS
# SQL_LLOYDS_TAGETIK_SCHEMA=tagetik
# SQL_LLOYDS_TAGETIK_TABLE=TagetikWrittenforDataLoaderADP
# SQL_LLOYDS_TAGETIK_REPO_COLUMN=RepositoryID
# SQL_LLOYDS_TAGETIK_RUN_COLUMN=_ACCEL_UNIQUE_RUN_ID
# SQL_LLOYDS_REUSE_SQLSERVER_SPN=1
# SQL_LLOYDS_TENANT_ID=
# SQL_LLOYDS_CLIENT_ID=
# SQL_LLOYDS_CLIENT_SECRET=

# ═══════════════════════════════════════════════════════════════════════════
# LLOYD'S — F&O / DATAVERSE MIRRORED FABRIC WAREHOUSE SQL (dedicated TDS endpoint)
# ═══════════════════════════════════════════════════════════════════════════
# **Not** SQLSERVER_HOST / SQLSERVER_DEFAULT_DB — keep those for Mule PROCESS_TRACKER and other SQL servers.
#
# TM Confluence: *Lloyds QA Environment Access and Blocker Management* (TM page 3069050881) —
# **Lloyds Integrated QA env** → SQL Connection String host + SQL Analytics Endpoint database name.
#
# Entra (service principal): same preference as other Lloyd's paths — **AZURE_*** first, then **D365_***,
# then **SQLSERVER_*** as fallback (see `resolveLloydsFnOFabricSqlSpnOptional` / `lloydsFnOFabricSqlClient.ts`; SSO if SPN fails).
#
# Optional: LLOYDS_FNOFABRIC_SQL_TRUST_SERVER_CERTIFICATE=true (local debugging only; weakens TLS validation)
# Optional: LLOYDS_FNOFABRIC_SQLSERVER_PORT=1433
# If SPN connect fails (or no AZURE_* / D365_* / SQLSERVER_* secret triple), Fabric client falls back to
# **DefaultAzureCredential** (Azure CLI / VS Code / MI) for `https://database.windows.net/.default`.
# CI fail-fast: LLOYDS_FNOFABRIC_SQL_DISABLE_SSO_FAILOVER=1
# Dev / until warehouse SPN exists: LLOYDS_FNOFABRIC_SQL_PREFER_SSO=1 (skip SPN; same identity as SSMS Azure AD user).
# SSO uses tedious `azure-active-directory-default` by default (Fabric-friendly). Legacy: LLOYDS_FNOFABRIC_SQL_SSO_USE_ACCESS_TOKEN=1
# ═══════════════════════════════════════════════════════════════════════════

# Host + database come from Fabric workspace → warehouse → SQL analytics endpoint (SSMS); the hostname middle segment can change when the item is recreated.
LLOYDS_FNOFABRIC_SQLSERVER_HOST=cbdsu772ffbuhbbc4lhqc5ga5q-xxxxxxxxxxxxxxxxxxxxxxxx.datawarehouse.fabric.microsoft.com
LLOYDS_FNOFABRIC_SQLSERVER_DATABASE=dataverse_accelinsuat_cds2_workspace_unqee161b4bebfaed11a66b002248436
#
# F&O mirror **health counts** (generaljournalentry + `ods` staging): `npm run lloyds:fabric-fno-mirror-health`
# — query list in `src/integrations/lloyds/lloydsFabricFnoMirrorHealthQueries.ts`; SSMS copy in `docs/lloyds/ADP.sql`.
# Optional: `LLOYDS_FNOFABRIC_ODS_SCHEMA=ods` (default), `LLOYDS_FNOFABRIC_GJE_QUALIFIED_NAME=dbo.generaljournalentry`
# or three-part `dataverse_....dbo.generaljournalentry` if your default database differs from the GJE catalog.

# Dynamics 365 Finance (F&O) OData — Lloyd's E2E opt-in (`@PP-391-FNO-001` in `lloyds-pipeline-e2e-readonly.feature`).
# Sandbox host (programme): https://accelins-gc.sandbox.operations.dynamics.com/
# Token scope defaults to `https://<host>/.default` (override with LLOYDS_FNO_ODATA_SCOPE if required).
# LLOYDS_FNO_ODATA_ENABLED=1
# LLOYDS_FNO_ODATA_BASE_URL=https://accelins-gc.sandbox.operations.dynamics.com/data
# Per-repo E2E (`@PP-391-FNO-001`): OData path/query under /data with literal `{repo}` (replaced per Examples).
# Lloyd's F&O **company is always AEUM** (`dataAreaId` / `cmp`) — only the repository id (`US-xxxxx`) changes across repos; bake `AEUM` into the filter (e.g. journal Description `AEUM US-61273`).
# Programme must expose an entity + filter; confirm names in `/data/$metadata`. Example shapes (replace if your journal text differs):
# Public collection is **LedgerJournalLines** (not LedgerJournalTrans); line narrative field is **Text** (see MS Learn: LedgerJournalLine).
# LLOYDS_FNO_ODATA_REPO_PATH_TEMPLATE=LedgerJournalLines?$filter=dataAreaId eq 'AEUM' and substringof('{repo}',Text)&$top=5
# Legacy / wrong entity name (HTTP 404): LedgerJournalTrans + Txt — do not use.
#
# **Fabric / Dataverse staging tables** (e.g. ACCCustTransStaging, ACCCustSettleStaging — programme matrix) are **not** the same
# endpoint as Finance **OData** `/data`; mirror SQL may live under **`LLOYDS_FNOFABRIC_SQLSERVER_*`**. Use `$metadata` on the
# F&O host to pick the correct **entity set** name before wiring `LLOYDS_FNO_ODATA_REPO_PATH_TEMPLATE`.
# Optional explicit Entra scope (otherwise derived from base URL origin):
# LLOYDS_FNO_ODATA_SCOPE=https://accelins-gc.sandbox.operations.dynamics.com/.default
#
# Power BI workspace (human UI for lakehouse / reports — not used by automation directly):
# https://app.powerbi.com/groups/33919af9-ec62-4469-b42b-688c1b6c5558/list?trident=1&experience=power-bi

# ═══════════════════════════════════════════════════════════════════════════
# MICROSOFT FABRIC (REST API + optional SQL endpoint hints)
# ═══════════════════════════════════════════════════════════════════════════
# Workspace URL: https://app.fabric.microsoft.com/groups/{FABRIC_WORKSPACE_ID}/...
# Full setup: docs/setup/FABRIC_CONNECTIVITY_SETUP.md
# Secrets: same pattern as other services — use src/config/env/.env.qa (gitignored).
#
# REST API (list workspace items, metadata): Entra app with Fabric/Power BI API permissions.
# Warehouse / lakehouse **TDS** reads for Lloyd's: use **LLOYDS_FNOFABRIC_SQLSERVER_*** (see block above),
# not SQLSERVER_DEFAULT_DB, when you have multiple SQL endpoints.
# ═══════════════════════════════════════════════════════════════════════════

FABRIC_WORKSPACE_ID=your-workspace-guid-from-fabric-url
FABRIC_TENANT_ID=your-tenant-id-guid
FABRIC_CLIENT_ID=your-fabric-or-shared-spn-client-id
FABRIC_CLIENT_SECRET=your-client-secret

# Optional (default: https://api.fabric.microsoft.com/v1)
# FABRIC_API_BASE_URL=https://api.fabric.microsoft.com/v1

# Optional: document SQL endpoint host/database for Fabric (use with SQLSERVER_* for actual connection)
# FABRIC_SQL_ENDPOINT_HOST=xxxxx.datawarehouse.fabric.microsoft.com
# FABRIC_SQL_DATABASE=your_warehouse_name

# Optional: disable TLS verify only for local debugging (not recommended)
# FABRIC_REJECT_UNAUTHORIZED=false

# If FABRIC_TENANT_ID is omitted, D365_TENANT_ID / dynamics tenant from qa.json may be used.

# ═══════════════════════════════════════════════════════════════════════════
# MULESOFT ANYPOINT PLATFORM (API access for log verification)
# ═══════════════════════════════════════════════════════════════════════════
# OAuth2 client credentials (Connected App). Used to verify app status and retrieve logs.
# Setup: See docs/setup/MULESOFT_ACCESS_REQUIREMENTS.md
# ═══════════════════════════════════════════════════════════════════════════

# Connected App credentials (from Anypoint: Access Management → Connected Apps)
MULESOFT_CLIENT_ID=your_connected_app_client_id
MULESOFT_CLIENT_SECRET=your_connected_app_client_secret

# Base URL: US = https://anypoint.mulesoft.com | EU = https://eu1.anypoint.mulesoft.com
# MULESOFT_BASE_URL=https://eu1.anypoint.mulesoft.com

# Required for CloudHub 2 log / deployment APIs (same UUIDs as Postman organization_id / environment_id)
# MULESOFT_ORGANIZATION_ID=your_organization_id_guid
# Alias: MULESOFT_ORG_ID (either name works)
# MULESOFT_ENVIRONMENT_ID=your_environment_id_guid
# Alias: MULESOFT_ENV_ID

# Optional: override API base URL (default: {baseUrl}/amc/application-manager/api/v2)
# MULESOFT_API_BASE_URL=https://eu1.anypoint.mulesoft.com/amc/application-manager/api/v2

TAKE_SCREENSHOTS=false
CAPTURE_EVIDENCE=false

