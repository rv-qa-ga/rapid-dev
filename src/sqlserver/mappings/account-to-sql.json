      "description": "Website URL"
    },
    {
      "sourceField": "CreatedDate",
      "sqlColumn": "CreatedDate",
      "description": "Record creation date",
      "transform": "datetime"
    },
    {
      "sourceField": "LastModifiedDate",
      "sqlColumn": "LastModifiedDate",
      "description": "Last modification date",
      "transform": "datetime"
    }
  ],
  "keyFields": [
